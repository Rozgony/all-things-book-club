<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <style>@import url('https://fonts.googleapis.com/css2?family=Pontano+Sans:wght@400;700&display=swap');</style>
</head>
<body style="margin:0;padding:0;background-color:#f5f2ee;font-family:'Pontano Sans',system-ui,sans-serif;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#f5f2ee;padding:32px 0;">
    <tr>
      <td align="center">
        <table role="presentation" width="480" cellpadding="0" cellspacing="0" style="background-color:#ffffff;border:1px solid #ddd8d3;border-radius:6px;">
          <tr>
            <td style="padding:36px 40px;">
              <p style="margin:0 0 20px;font-size:16px;line-height:1.6;color:#3f4a49;font-family:'Pontano Sans',system-ui,sans-serif;">
                <strong>{{.InviterEmail}}</strong> has invited you to join a chapter on All Things Book Club.
              </p>
              <table role="presentation" cellpadding="0" cellspacing="0" style="margin:0 0 24px;">
                <tr>
                  <td align="center" style="border-radius:4px;background-color:#3d5a54;">
                    <a href="{{.InviteURL}}" style="display:inline-block;padding:12px 28px;font-size:15px;font-family:'Pontano Sans',system-ui,sans-serif;letter-spacing:0.01em;color:#ffffff;text-decoration:none;font-weight:bold;">Accept Invite</a>
                  </td>
                </tr>
              </table>
              <p style="margin:0;font-size:13px;line-height:1.5;color:#6b7a79;font-family:'Pontano Sans',system-ui,sans-serif;">This link expires in 7 days.</p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
